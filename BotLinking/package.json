{
  "name": "@voax/linking-bot",
  "version": "1.1.0",
  "private": true,
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node index.js",
